#include <winuser.h>

// Application icon (first icon in the exe is the one Explorer shows).
101 ICON "app.ico"

// Enables visual styles (Common Controls v6) and DPI awareness.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Pictogram Parser"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductName", "Pictogram Parser"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "PictogramParser.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 Andrii Kamlyk. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
